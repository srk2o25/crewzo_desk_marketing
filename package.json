{
  "name": "crewzo-desk-marketing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint:content": "node scripts/check-config.mjs && node scripts/lint-content.mjs",
    "llms": "node scripts/generate-llms.mjs",
    "predev": "npm run llms && npm run css:preview",
    "dev": "next dev",
    "prebuild": "npm run lint:content && npm run llms && npm run css:preview",
    "build": "next build",
    "postbuild": "node scripts/nest-output.mjs && node scripts/verify-build.mjs",
    "test:lint": "node scripts/lint-content.mjs --dir scripts/fixtures --expect-fail",
    "css:preview": "tailwindcss -c tailwind.preview.config.ts -i styles/preview.css -o public/admin/preview.css --minify",
    "cms": "npm run predev && concurrently -k -n cms,site -c blue,green \"decap-server\" \"next dev\""
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.0",
    "mdast-util-to-string": "^4.0.0",
    "next": "^15.5.25",
    "react": "^19",
    "react-dom": "^19",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.0.1",
    "concurrently": "^10.0.5",
    "decap-server": "^3.11.3",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
